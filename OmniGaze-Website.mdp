<!-- slide -->
<div class="slide-header">What the Website <span class="accent">Does</span></div>
<div class="card-grid card-grid-3">
    <div class="card">
        <div class="card-title">Marketing & Sales</div>
        <div class="card-desc">Landing page, features showcase, pricing tiers, and competitive positioning to convert visitors into customers.</div>
    </div>
    <div class="card">
        <div class="card-title">Registration & Onboarding</div>
        <div class="card-desc">Email verification flow, tier selection, license key generation, and getting started guidance.</div>
    </div>
    <div class="card">
        <div class="card-title">Account Portal</div>
        <div class="card-desc">Dashboard, subscription management, billing history, license keys, team management, and settings.</div>
    </div>
    <div class="card">
        <div class="card-title">Purchase & Checkout</div>
        <div class="card-desc">Stripe-powered checkout for tier upgrades with monthly and annual billing options.</div>
    </div>
    <div class="card">
        <div class="card-title">Documentation Hub</div>
        <div class="card-desc">Comprehensive docs with getting started guides, feature tutorials, API reference, and security setup.</div>
    </div>
    <div class="card">
        <div class="card-title">Download Center</div>
        <div class="card-desc">Desktop client download with system requirements and version information.</div>
    </div>
</div>

